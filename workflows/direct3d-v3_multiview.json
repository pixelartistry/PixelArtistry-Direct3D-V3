"fp16", true, true, "refined_mv_1536", "glb", "single_stage", "efficient", "lossless", "auto", "cfg", 0, 0, 6, 0, "marching_cubes", 1, 1, 1, 1, 1, "facing", 1, 1, "quality"], "widgets_values_named": {"resolution": 1536, "steps": 8, "guidance": 4, "max_tokens": 150000, "token_fit": "shrink_to_fit", "seed": 42, "control_after_generate": "fixed", "model": "wushuang98/Direct3D-V3", "dtype": "fp16", "offline": true, "use_alpha": true, "output_prefix": "refined_mv_1536", "file_format": "glb", "stage_mode": "single_stage", "attention_backend": "efficient", "accel_mode": "lossless", "back_weight": 1, "left_weight": 1, "right_weight": 1, "top_weight": 1, "bottom_weight": 1, "multiview_mode": "facing", "front_weight": 1, "boundary_feather": 1, "multiview_speed": "quality"}, "title": "Direct3D-V3 refine multiview"}, {"id": 6, "type": "LoadImage", "pos": [20, 1260], "size": [400, 520], "flags": {}, "order": 3, "mode": 0, "inputs": [{"localized_name": "image", "name": "image", "type": "COMBO", "widget": {"name": "image"}, "link": null}, {"localized_name": "choose file to upload", "name": "upload", "type": "IMAGEUPLOAD", "widget": {"name": "upload"}, "link": null}], "outputs": [{"localized_name": "IMAGE", "name": "IMAGE", "type": "IMAGE", "links": [6, 9]}, {"localized_name": "MASK", "name": "MASK", "type": "MASK", "links": null}], "properties": {"cnr_id": "comfy-core", "ver": "0.45.4", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}}, "Node name for S&R": "LoadImage"}, "widgets_values": ["example.png", "image"], "widgets_values_named": {"image": "example.png", "upload": "image"}, "title": "Back image (same object from directly behind)"}, {"id": 7, "type": "RemoveBackground", "pos": [460, 1260], "size": [181.705078125, 46], "flags": {}, "order": 5, "mode": 0, "inputs": [{"localized_name": "bg_removal_model", "name": "bg_removal_model", "type": "BACKGROUND_REMOVAL", "link": 8}, {"localized_name": "image", "name": "image", "type": "IMAGE", "link": 9}], "outputs": [{"localized_name": "mask", "name": "mask", "type": "MASK", "links": [7]}], "properties": {"cnr_id": "comfy-core", "ver": "0.45.4", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}}, "Node name for S&R": "RemoveBackground"}, "title": "Remove background (back)"}, {"id": 8, "type": "MarkdownNote", "pos": [20, 30], "size": [1600, 300], "flags": {}, "order": 36, "mode": 0, "inputs": [], "outputs": [], "title": "Note", "properties": {}, "widgets_values": ["## Refine a mesh with a front and a back image (Direct3D-V3 multiview)\nDirect3D-V3 normally sees only the front image and has to guess the back. Here it also gets a back image.\n\n1. **Front image:** upload the image the mesh was made from. BiRefNet cuts it out.\n2. **Back image:** upload an image of the same object from directly behind: upright, same pose, whole object in frame.\n3. **Mesh:** put a GLB or OBJ into `ComfyUI/input` and type its file name, or paste a full path.\n4. Run. Result: `output/Direct3D-V3/refined_mv_1536_<id>.glb`.\n\n**More views:** add one Load Image and one Remove Background node per view and connect them to `left_`, `right_`, `top_` or `bottom_image` and `_mask`. Left is the model's own left side (the right edge of the front image). Top view: the front of the model at the bottom edge of the image.\n\n**The back image must match the mesh.** Where it shows other shapes than the mesh has, the result smears.\n\n**Time:** one extra view makes sampling about 1.8 times as long with `multiview_speed` quality, or 1.4 times with fast (a little rougher). Measured with one back image at 1024 on an RTX 5080; VRAM did not rise.\n\n**Less memory:** lower `max_tokens` (`shrink_to_fit` then scales the model down a little) or set `resolution` to 1024.\n\nNodes and multiview method by Mstafa-awad, model by DreamTechAI (MIT)."], "color": "#222", "bgcolor": "#000"}], "links": [[1, 2, 0, 3, 0, "BACKGROUND_REMOVAL"], [2, 1, 0, 3, 1, "IMAGE"], [3, 4, 0, 5, 0, "MESH_PATH"], [4, 1, 0, 5, 1, "IMAGE"], [5, 3, 0, 5, 2, "MASK"], [6, 6, 0, 5, 3, "IMAGE"], [7, 7, 0, 5, 4, "MASK"], [8, 2, 0, 7, 0, "BACKGROUND_REMOVAL"], [9, 6, 0, 7, 1, "IMAGE"]], "groups": [], "config": {}, "extra": {"ds": {"scale": 0.7, "offset": [40, 40]}}, "version": 0.4}